{
  "name": "rust-webp-converter",
  "version": "0.1.0",
  "description": "Fast image to WebP conversion for Node.js, with animated GIF support, powered by libwebp and napi-rs",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromneto97/webp-converter.git"
  },
  "bugs": {
    "url": "https://github.com/pedromneto97/webp-converter/issues"
  },
  "homepage": "https://github.com/pedromneto97/webp-converter#readme",
  "license": "MIT",
  "keywords": [
    "webp",
    "image",
    "gif",
    "animated-webp",
    "libwebp",
    "converter",
    "napi-rs",
    "node-addon"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "webp-converter",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">= 22.14.0 < 23 || >= 23.6.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:oxfmt format:rs",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "prepare": "husky"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.1",
    "@oxc-node/core": "^0.1.2",
    "@types/node": "^26.6.4",
    "ava": "^8.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.83.0",
    "tinybench": "^6.2.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
